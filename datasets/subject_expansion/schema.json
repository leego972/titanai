{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titan Subject Expansion Record",
  "type": "object",
  "required": ["messages", "metadata"],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 20}
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["dataset", "id", "subject", "task", "difficulty", "quality", "provenance"],
      "properties": {
        "dataset": {"type": "string", "minLength": 3},
        "id": {"type": "string", "minLength": 4},
        "subject": {"type": "string", "minLength": 3},
        "task": {"type": "string", "minLength": 3},
        "difficulty": {"enum": ["medium", "hard", "expert"]},
        "quality": {"enum": ["curated", "verified-synthetic"]},
        "provenance": {"enum": ["original", "licensed", "public-domain", "synthetic"]},
        "answer_verifiability": {"enum": ["deterministic", "evidence-grounded", "rubric-scored"]},
        "skills": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
