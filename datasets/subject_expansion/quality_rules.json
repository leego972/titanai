{
  "version": "1.0.0",
  "minimums": {
    "user_content_chars": 120,
    "assistant_content_chars": 180,
    "skills_per_record": 2,
    "difficulty_allowed": ["medium", "hard", "expert"]
  },
  "reject_if": {
    "contains_empty_messages": true,
    "duplicate_prompt": true,
    "near_duplicate_similarity_gte": 0.92,
    "answer_repeats_prompt_without_analysis": true,
    "unsupported_specific_factual_claims": true,
    "requires_missing_information_without_acknowledging_uncertainty": true,
    "contains_private_or_personal_data": true,
    "unclear_redistribution_rights": true,
    "train_validation_test_prompt_family_leakage": true
  },
  "required_answer_behaviours": [
    "identify relevant evidence",
    "perform the requested reasoning or analysis",
    "distinguish evidence from inference when material",
    "state uncertainty when evidence is insufficient",
    "avoid fabricating unavailable facts",
    "provide a conclusion proportional to the evidence"
  ],
  "preferred_record_mix": {
    "medium": 0.2,
    "hard": 0.55,
    "expert": 0.25
  },
  "evaluation": {
    "minimum_rubric_score": 0.85,
    "rubric_dimensions": [
      "correctness",
      "reasoning_depth",
      "evidence_use",
      "constraint_adherence",
      "uncertainty_calibration",
      "clarity",
      "non_redundancy"
    ]
  }
}
