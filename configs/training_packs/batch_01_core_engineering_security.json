{
  "schema_version": "1.0",
  "pack_id": "titan-professional-batch-01",
  "title": "Core Engineering and Defensive Security",
  "target_model": "titan-3b",
  "replacement_mode": "supersede_legacy",
  "legacy_globs": [
    "data/raw/corpus_D_cyber/advanced_training_pack_*.txt",
    "data/raw/**/*synthetic*.jsonl",
    "data/raw/**/*qa*.jsonl"
  ],
  "output_root": "data/professional/batch_01",
  "quality": {
    "minimum_text_chars": 240,
    "maximum_text_chars": 120000,
    "minimum_quality_score": 0.72,
    "maximum_duplicate_similarity": 0.92,
    "require_provenance": true,
    "require_usage_basis": true,
    "reject_secrets": true,
    "holdout_fraction": 0.02,
    "validation_fraction": 0.01
  },
  "stages": {
    "cpt": 0.55,
    "sft": 0.35,
    "dpo": 0.08,
    "evaluation": 0.02
  },
  "domains": [
    "software_engineering",
    "secure_coding",
    "application_security",
    "systems_engineering",
    "databases",
    "distributed_systems",
    "testing_and_debugging",
    "devops_and_observability",
    "vulnerability_management",
    "detection_engineering",
    "incident_response",
    "threat_modelling"
  ],
  "accepted_formats": ["jsonl", "json", "txt", "md", "csv", "zip", "tar", "tar.gz", "tgz"],
  "record_contract": {
    "required": ["content", "source", "usage_basis", "domain"],
    "optional": [
      "instruction",
      "response",
      "chosen",
      "rejected",
      "code",
      "tests",
      "references",
      "version",
      "retrieved_at",
      "language",
      "stage",
      "tags"
    ]
  },
  "source_families": [
    {
      "name": "primary_security_knowledge",
      "examples": ["MITRE CWE", "MITRE CAPEC", "MITRE ATT&CK", "NVD", "CISA KEV", "NIST", "OWASP"],
      "preferred_stage": "cpt"
    },
    {
      "name": "permissive_code_and_repository_history",
      "examples": ["permissively licensed repositories", "issues", "pull requests", "commits", "tests"],
      "preferred_stage": "cpt_sft"
    },
    {
      "name": "professional_instruction_records",
      "examples": ["diagnosis", "design", "implementation", "review", "testing", "deployment"],
      "preferred_stage": "sft"
    },
    {
      "name": "quality_preferences",
      "examples": ["correct vs incorrect patch", "maintainable vs brittle design", "complete vs incomplete incident analysis"],
      "preferred_stage": "dpo"
    }
  ]
}
